# Fictitious production values only. Do not copy credentials from development.
RADAR_SECRET_KEY=replace-with-a-long-random-secret
RADAR_ALLOWED_HOSTS=seleccion.example.test
RADAR_CSRF_TRUSTED_ORIGINS=https://seleccion.example.test
RADAR_DB_NAME=radar_production
RADAR_DB_USER=radar_app
RADAR_DB_PASSWORD=replace-with-provider-secret
RADAR_DB_HOST=postgres.internal.example.test
RADAR_DB_PORT=5432
RADAR_DB_SSLMODE=require
RADAR_DB_CONN_MAX_AGE=60
RADAR_STATIC_ROOT=/var/lib/radar/staticfiles
RADAR_STATIC_URL=/static/
RADAR_MEDIA_ROOT=/var/lib/radar/media_privada
RADAR_HSTS_SECONDS=31536000
RADAR_HSTS_PRELOAD=false
# Enable only behind a known proxy and list its CIDR ranges.
RADAR_TRUST_PROXY_HEADERS=false
RADAR_TRUSTED_PROXY_IPS=10.0.0.0/8
